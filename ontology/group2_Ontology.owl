        <rdfs:range rdf:resource="http://www.semanticweb.org/group2/ontology#ResearchAndDevelopment"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/group2/ontology#isPlayedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/group2/ontology#isPlayedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/group2/ontology#Match"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/group2/ontology#Team"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/group2/ontology#locatedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/group2/ontology#locatedIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/ontology#City"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/ontology#Country"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/ontology#Location"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/group2/ontology#madeBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/group2/ontology#madeBy">
