    <!-- http://www.semanticweb.org/group2/ontology#relatedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/group2/ontology#relatedTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/group2/ontology#Claim"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/ontology#Company"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/ontology#Event"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/ontology#Person"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/group2/ontology#Sport"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


