<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/group2/ontology#"
     xml:base="http://www.semanticweb.org/group2/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/group2/ontology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/group2/ontology#aboutLocation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/group2/ontology#aboutLocation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/group2/ontology#Claim"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/group2/ontology#Location"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/group2/ontology#affects -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/group2/ontology#affects">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/group2/ontology#HealthCondition"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/group2/ontology#Food"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/group2/ontology#assessedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/group2/ontology#assessedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/group2/ontology#ClaimAssessment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/group2/ontology#Source"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/group2/ontology#assessmentOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/group2/ontology#assessmentOf">
