:ClaimAssessment a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Source ;
            owl:onProperty :assessedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Claim ;
            owl:onProperty :assessmentOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty :isValid ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        owl:Thing .

